# Dependencies
node_modules/
.npm
.pnpm-store/

# Wrangler
.wrangler/
.dev.vars
worker-configuration.d.ts
packages/**/.wrangler/
packages/**/.dev.vars
packages/**/.dev.vars.local

# Build outputs
dist/
*.local
*.tsbuildinfo
tsconfig.tsbuildinfo

# Python (for security-tests and any future Python usage)
venv/
.venv/
ENV/
__pycache__/
*.pyc
*.pyo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment variables
.env
.env.local
.env.*.local

# Database backups
*.sql
backup-*.sql
# ...but D1 migrations are source code, not backups. The rule above had been
# silently excluding every migration since the Cloudflare rewrite, so a fresh
# clone had no schema at all.
!packages/backend/migrations/*.sql
# 同理：測試 fixture 的 schema 也是原始碼。沒 commit 的話，clone 下來跑 test 會直接掛。
!packages/backend/tests/fixtures/*.sql

# Test coverage
coverage/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Temporary files
tmp/
temp/

# Backup files
**/*.bak
**/*.backup
**/*.old
**/bak/
**/backup/

# Shell scripts (project-specific utility scripts)
*.sh
# 保留 pnpm 需要的 scripts 目錄
!scripts/*.sh
# `!scripts/*.sh` 只解除最外層那一層（含斜線的 pattern 錨定在 .gitignore 所在目錄），
# 各 package 底下的 scripts/ 要各自解除
!packages/*/scripts/*.sh

# Auto-generated theme files
packages/frontend/src/styles/_theme-generated.scss

# tsc 不慎轉譯 vite.config.ts 的產物（正確輸出已導向 node_modules/.tmp）
packages/frontend/vite.config.js
packages/frontend/vite.config.d.ts
